<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- Pure-managed cross-platform imaging; replaces System.Drawing for loading fixtures on macOS. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoeAncientsPriceHelper.Core\PoeAncientsPriceHelper.Core.csproj" />
  </ItemGroup>

  <!-- Reuse the Windows regression fixtures so Mac tests assert the same real captures. -->
  <ItemGroup>
    <None Include="Fixtures\Runeshape\**\capture_region.png"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PoeAncientsPriceHelper.Tests\Fixtures\Runeshape\**\capture_region.png"
          Link="Fixtures\Runeshape\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
