<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>PoeAncientsPriceHelper</RootNamespace>
    <AssemblyName>RuneshapePriceHelper</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Declares Per-Monitor-V2 DPI awareness at process start (see app.manifest, issue #8). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Runeshape Price Helper</AssemblyTitle>
    <Product>Runeshape Price Helper</Product>
    <Description>Screen overlay for Path of Exile 2 that OCRs the Runeshape panel and shows cached poe.ninja prices.</Description>
    <Version>1.2.0</Version>
    <Authors>RemusRD</Authors>
    <Company>RemusRD</Company>
    <Copyright>Copyright © 2026 RemusRD</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <None Include="Start.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PoeAncientsPriceHelper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpHook" Version="7.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Data.English" Version="4.0.0" />
  </ItemGroup>


</Project>
